{
    "name": "Art-DB",
    "short_name": "Art-DB",
    "description": "Správa portfólia, zbierok a predaja umeleckých diel.",
    "start_url": "/admin",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#1e293b",
    "theme_color": "#1e293b",
    "lang": "sk",
    "dir": "ltr",
    "icons": [
        {
            "src": "/pwa/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/pwa/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/pwa/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/pwa/icon-1024.png",
            "sizes": "1024x1024",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "shortcuts": [
        {
            "name": "Pridať dielo",
            "short_name": "Dielo",
            "url": "/admin/artworks/create",
            "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Pridať umelca",
            "short_name": "Umelec",
            "url": "/admin/artists/create",
            "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Môj profil",
            "short_name": "Profil",
            "url": "/admin/profile",
            "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }]
        }
    ],
    "categories": ["business", "productivity"],
    "prefer_related_applications": false
}
