# ─────────────────────────────────────────────────────────────────────────────
#  Art DB — production .env template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env on the production server, fill in every <PLACEHOLDER>,
# then run:
#   php artisan key:generate --force
#   php artisan config:cache
#   php artisan migrate --force
#   php artisan storage:link
#
# Never commit a filled-in .env. .gitignore already excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Art DB"
APP_ENV=production
APP_KEY=                                  # php artisan key:generate fills this
APP_DEBUG=false
APP_URL=https://art-db.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                         # error/warning in prod; debug only when debugging

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=artdb
DB_USERNAME=artdb
DB_PASSWORD=<STRONG_DB_PASSWORD>

# ── Sessions / Cache / Queue ──────────────────────────────────────────────────
# database driver is the no-extra-infra default. Switch to redis once you add
# Redis (recommended once you have >100 concurrent users).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true                # HTTPS-only cookies in prod

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3                        # see S3 block below
QUEUE_CONNECTION=database                 # → redis when scaling

CACHE_STORE=database
# CACHE_PREFIX=artdb_

# ── Redis (optional but recommended at scale) ─────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Resend) ─────────────────────────────────────────────────────────────
# Verify your domain at https://resend.com/domains before flipping MAIL_MAILER.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="info@art-db.org"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=<re_PROD_KEY_FROM_RESEND>

# ── Mailchimp (newsletter) ────────────────────────────────────────────────────
MAILCHIMP_API_KEY=<MC_KEY>-<DC>
MAILCHIMP_LIST_ID=<AUDIENCE_ID>

# ── Stripe (Cashier — LIVE keys!) ─────────────────────────────────────────────
# Switch from sk_test_… / pk_test_… to sk_live_… / pk_live_… in prod.
# Webhook secret comes from Dashboard → Developers → Webhooks → your endpoint.
STRIPE_KEY=<pk_live_…>
STRIPE_SECRET=<sk_live_…>
STRIPE_WEBHOOK_SECRET=<whsec_…>
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=sk_SK

# Live price IDs — DIFFERENT from test mode. Create the same Starter/Pro/Studio
# products in live mode and paste price_… below.
STRIPE_PRICE_STARTER_MONTHLY=<price_…>
STRIPE_PRICE_STARTER_YEARLY=<price_…>
STRIPE_PRICE_PRO_MONTHLY=<price_…>
STRIPE_PRICE_PRO_YEARLY=<price_…>
STRIPE_PRICE_STUDIO_MONTHLY=<price_…>
STRIPE_PRICE_STUDIO_YEARLY=<price_…>

# ── Storage (S3 / R2 / Backblaze) ─────────────────────────────────────────────
# Production stores uploads off the web server so they survive deploys + scaling.
# Cloudflare R2 = cheapest egress; AWS S3 = most compatible; Backblaze B2 = cheap.
AWS_ACCESS_KEY_ID=<AKIA…>
AWS_SECRET_ACCESS_KEY=<…>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=artdb-prod
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com    # R2 example
AWS_URL=https://cdn.art-db.org                                # CNAME → bucket

# ── Frontend / Vite ───────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
